---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RedLight from '../../components/RedLight.astro';
import { langPaths, t, type Lang } from '../../i18n';
import { phoneLink, site, whatsappLink } from '../../config/site';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const { contact } = t(lang);
---

<BaseLayout lang={lang} title={contact.title} description={contact.description} path="/contact">
  <section class="page-hero hero">
    <RedLight variant="subtle" />
    <div class="container inner">
      <h1>{contact.heading}</h1>
      <p class="lead">{contact.lead}</p>
    </div>
  </section>

  <section class="section top0">
    <div class="container layout">
      <form
        class="card form"
        action={site.formEndpoint}
        method="POST"
        data-sending={contact.sending}
        data-success={contact.success}
        data-error={contact.error}>
        <h2>{contact.formHeading}</h2>
        <div class="row">
          <label>
            <span>{contact.name}</span>
            <input name="name" type="text" autocomplete="name" required />
          </label>
          <label>
            <span>{contact.email}</span>
            <input name="email" type="email" autocomplete="email" inputmode="email" required />
          </label>
        </div>
        <div class="row">
          <label>
            <span>{contact.phone}</span>
            <input name="phone" type="tel" autocomplete="tel" inputmode="tel" />
          </label>
          <label>
            <span>{contact.subject}</span>
            <select name="subject">
              {contact.subjects.map((s) => <option>{s}</option>)}
            </select>
          </label>
        </div>
        <label>
          <span>{contact.message}</span>
          <textarea name="message" rows="6" required></textarea>
        </label>
        <!-- Spam trap: people never see or fill this field. -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="trap" aria-hidden="true" />
        <button class="btn btn-primary" type="submit">{contact.send}</button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>

      <aside class="details">
        <div class="card">
          <h2>{contact.phoneHeading}</h2>
          <p><a href={phoneLink()}>{site.phone}</a></p>
          <a class="btn btn-whatsapp" href={whatsappLink(contact.whatsappMessage)} target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"
              ><path
                d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3z"
              ></path></svg
            >
            {contact.whatsappButton}
          </a>
        </div>
        <div class="card">
          <h2>{contact.emailHeading}</h2>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div class="card">
          <h2>{contact.locationHeading}</h2>
          <p class="muted">{site.country}</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  // Sends the form without leaving the page. Without JavaScript the form
  // still posts normally to the form service.
  const form = document.querySelector<HTMLFormElement>('form.form');
  if (form) {
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.textContent;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      button.textContent = form.dataset.sending ?? '';
      status.className = 'status';
      status.textContent = '';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.classList.add('ok');
        status.textContent = form.dataset.success ?? '';
      } catch {
        status.classList.add('err');
        status.textContent = form.dataset.error ?? '';
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .inner {
    position: relative;
    z-index: 1;
  }

  .top0 {
    padding-top: 24px;
  }

  .layout {
    display: grid;
    gap: 24px;
    align-items: start;
  }

  h2 {
    font-size: 1.35rem;
  }

  .form {
    display: grid;
    gap: 18px;
  }

  .row {
    display: grid;
    gap: 18px;
  }

  label {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.95rem;
  }

  input,
  select,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--white);
    background: var(--black);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 10px;
    padding: 12px 14px;
    min-height: 48px;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--red);
    box-shadow: 0 0 0 3px rgb(255 49 48 / 0.25);
  }

  textarea {
    resize: vertical;
  }

  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .form .btn {
    justify-self: start;
  }

  button:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .status {
    margin: 0;
    min-height: 1.5em;
  }

  .status:global(.ok) {
    color: #6ee7a0;
  }

  .status:global(.err) {
    color: #ff8c8b;
  }

  .details {
    display: grid;
    gap: 16px;
  }

  /* On phones, show WhatsApp and email before the form. */
  @media (max-width: 959px) {
    .details {
      order: -1;
    }
  }

  .details a:not(.btn) {
    color: var(--white);
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
    word-break: break-word;
  }

  .details a:not(.btn):hover {
    color: var(--red);
  }

  .btn-whatsapp {
    background: #25d366;
    color: #06240f;
  }

  @media (min-width: 640px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 960px) {
    .layout {
      grid-template-columns: 1.6fr 1fr;
    }
  }
</style>
