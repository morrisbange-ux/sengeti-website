---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { defaultLang, langs, localizePath, t, type Lang } from '../../../i18n';
import { formatDate, newsTypeLabel, getNews, type NewsPost } from '../../../lib/content';
import { site } from '../../../config/site';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of langs) {
    for (const post of await getNews(lang)) {
      paths.push({ params: { lang: lang === defaultLang ? undefined : lang, slug: post.slug }, props: { lang, post } });
    }
  }
  return paths;
}

const { lang, post } = Astro.props as { lang: Lang; post: NewsPost };
const dict = t(lang);
const { data } = post;
const { Content } = await render(post);
const path = `/news/${post.slug}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    datePublished: data.date.toISOString(),
    author: { '@id': `${site.url}/#organization` },
    publisher: { '@id': `${site.url}/#organization` },
    mainEntityOfPage: new URL(localizePath(lang, path), site.url).href,
  },
];
---

<BaseLayout lang={lang} title={`${data.title} | ${site.name}`} description={data.description} path={path} schema={schema}>
  <article>
    <header class="page-hero">
      <div class="container narrow">
        <a class="back" href={localizePath(lang, '/news')}>← {dict.news.back}</a>
        <p class="eyebrow">
          {newsTypeLabel(data.type, dict.news)} · {formatDate(data.date, dict.locale)}
        </p>
        <h1>{data.title}</h1>
        <p class="lead">{data.description}</p>
        {data.client && <p class="muted">{dict.news.client}: {data.client}</p>}
      </div>
    </header>
    {data.cover && (
      <div class="container narrow">
        <Image src={data.cover} alt={data.coverAlt} width={900} class="cover" />
      </div>
    )}
    <div class="section top0">
      <div class="container narrow prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .narrow {
    max-width: 820px;
  }

  .back {
    display: block;
    width: fit-content;
    margin-bottom: 24px;
    color: var(--muted);
    text-decoration: none;
  }

  .cover {
    width: 100%;
    border-radius: var(--radius);
    margin-bottom: 24px;
  }

  .top0 {
    padding-top: 16px;
  }

  .prose {
    color: var(--text);
    font-size: 1.1rem;
  }
</style>
