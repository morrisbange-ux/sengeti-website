---
import type { ComponentProps } from 'astro/types';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RedLight from '../../components/RedLight.astro';
import Icon from '../../components/Icon.astro';
import ContactForm from '../../components/ContactForm.astro';
import { langPaths, localizePath, type Lang } from '../../i18n';
import { site } from '../../config/site';
import text from '../../i18n/pages/careers';

type IconName = ComponentProps<typeof Icon>['name'];

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const page = text[lang];
const roles = page.roles;

// Job listings for Google, only for roles that are actually open.
const schema = roles.map((r) => ({
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: r.title,
  description: `<p>${r.summary}</p>`,
  datePosted: r.datePosted,
  employmentType: r.employmentType,
  hiringOrganization: { '@type': 'Organization', '@id': `${site.url}/#organization`, name: site.name, sameAs: site.url },
  jobLocation: {
    '@type': 'Place',
    address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: site.countryCode },
  },
  url: `${site.url}${localizePath(lang, '/careers')}#role-${r.id}`,
}));

// Open roles come first in the drop-down, then the general areas.
const subjects = [...roles.map((r) => r.title), ...page.formAreas];
---

<BaseLayout lang={lang} title={page.title} description={page.description} path="/careers" schema={schema}>
  <section class="page-hero hero">
    <RedLight variant="subtle" />
    <div class="dot-grid" aria-hidden="true"></div>
    <div class="container inner">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.heading} <span class="gradient-text">{page.headingAccent}</span></h1>
      <p class="lead">{page.lead}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="#apply">{page.apply}</a>
        <a class="btn btn-ghost" href="#roles">{page.rolesHeading}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal><h2>{page.whyHeading}</h2></div>
      <div class="grid why">
        {
          page.why.map((w, i) => (
            <article class="card card-hover" data-reveal style={`--d:${i}`}>
              <span class="icon">
                <Icon name={w.icon as IconName} size={24} />
              </span>
              <h3>{w.title}</h3>
              <p class="muted">{w.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>{page.hireHeading}</h2>
        <p class="muted">{page.hireLead}</p>
      </div>
      <ol class="steps">
        {
          page.hireSteps.map((step, i) => (
            <li data-reveal style={`--d:${i}`}>
              <span class="num">{i + 1}</span>
              <h3>{step.title}</h3>
              <p class="muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="roles">
    <div class="container">
      <div class="section-head" data-reveal><h2>{page.rolesHeading}</h2></div>
      {
        roles.length > 0 ? (
          <div class="grid roles">
            {roles.map((r, i) => (
              <article class="card card-hover role" id={`role-${r.id}`} data-reveal style={`--d:${i % 3}`}>
                <h3>{r.title}</h3>
                <ul class="chips meta">
                  <li>{r.type}</li>
                  <li>{r.location}</li>
                </ul>
                <p class="muted">{r.summary}</p>
                <a class="btn btn-primary" href="#apply" data-apply-role={r.title}>
                  {page.apply}
                </a>
              </article>
            ))}
          </div>
        ) : (
          <div class="card empty" data-reveal>
            <span class="icon">
              <Icon name="users" size={24} />
            </span>
            <div>
              <h3>{page.noRolesTitle}</h3>
              <p class="muted">{page.noRolesText}</p>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section class="section top0" id="apply">
    <div class="container narrow">
      <ContactForm
        lang={lang}
        heading={page.formHeading}
        subjectLabel={page.formAreaLabel}
        subjects={subjects}
        messageLabel={page.formMessageLabel}
        emailSubject="Job application"
      />
      <p class="muted note">{page.formNote}</p>
    </div>
  </section>
</BaseLayout>

<script>
  // "Apply" on a role picks that role in the form's drop-down.
  document.querySelectorAll<HTMLAnchorElement>('[data-apply-role]').forEach((link) => {
    link.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('#apply select[name="subject"]');
      if (select) select.value = link.dataset.applyRole ?? '';
    });
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .inner {
    position: relative;
    z-index: 1;
  }

  .hero h1 {
    max-width: 18ch;
  }

  .hero .lead {
    margin-bottom: 2rem;
  }

  .why {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }

  .icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--red-soft);
    color: var(--red-text);
    margin-bottom: 16px;
  }

  .band {
    background: linear-gradient(180deg, transparent, rgb(255 49 48 / 0.06), transparent);
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }

  .steps li {
    padding: 20px 20px 20px 0;
    border-top: 2px solid var(--border);
  }

  .steps li:first-child {
    border-top-color: var(--red);
  }

  .steps h3 {
    margin-bottom: 0.3em;
  }

  .steps p {
    margin: 0;
  }

  .num {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--red-soft);
    color: var(--red-text);
    font-weight: 700;
    margin-bottom: 12px;
  }

  .roles {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  .role {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .role h3,
  .role p {
    margin: 0;
  }

  .role .btn {
    margin-top: auto;
    align-self: flex-start;
  }

  .meta li {
    font-size: 0.85rem;
  }

  .empty {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    align-items: flex-start;
    max-width: 820px;
  }

  .empty > div {
    flex: 1 1 240px;
  }

  .empty h3 {
    margin-bottom: 0.3em;
  }

  .top0 {
    padding-top: 0;
    scroll-margin-top: 80px;
  }

  .narrow {
    max-width: 820px;
  }

  .note {
    font-size: 0.9rem;
    margin-top: 12px;
  }
</style>
