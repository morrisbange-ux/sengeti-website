---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RedLight from '../../components/RedLight.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/Icon.astro';
import EduPhone from '../../components/EduPhone.astro';
import { sengetiEdu } from '../../i18n/pages/sengetiedu';
import { editionNames } from '../../i18n/pages/clients';
import SocialProof from '../../components/SocialProof.astro';
import NewsCard from '../../components/NewsCard.astro';
import SolutionsTeaser from '../../components/SolutionsTeaser.astro';
import StatsBand from '../../components/StatsBand.astro';
import IntroVideo from '../../components/IntroVideo.astro';
import { getNews } from '../../lib/content';
import { serviceIcon, servicePage } from '../../lib/services';
import { langPaths, localizePath, t, type Lang } from '../../i18n';
import { getProducts } from '../../lib/products';
import { homeExtras } from '../../i18n/pages/home';
import { schoolDemo } from '../../i18n/pages/schools';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const dict = t(lang);
const { home, services, solutions } = dict;
const x = homeExtras[lang];
const flow = solutions.automation.visual;
// Bento order: the two wide cards (process automation, systems integration) sit at opposite corners.
const bento = ['process-automation', 'workflow', 'reporting', 'custom-software', 'advice', 'integration']
  .map((id) => services.items.find((s) => s.id === id))
  .filter((s): s is (typeof services.items)[number] => !!s);
const products = await getProducts(lang);
const featured = products.filter((p) => p.data.featured);
const shown = featured.length ? featured : products.slice(0, 1);
const whyIcons = ['globe', 'wallet', 'phone', 'lock'] as const;
const caseStudies = (await getNews(lang)).filter((p) => p.data.type === 'case-study').slice(0, 3);
---

<BaseLayout lang={lang} title={home.title} description={home.description} path="/">
  <section class="hero">
    <RedLight />
    <div class="line-grid" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <a class="badge" href={localizePath(lang, '/school-demo')}>
          <span class="badge-tag">{x.badgeTag}</span>
          <span class="badge-text">{x.badge}</span>
          <Icon name="arrow" size={16} />
        </a>
        <h1>{home.heading} <span class="gradient-text">{home.headingAccent}</span></h1>
        <p class="lead">{home.lead}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={localizePath(lang, '/services')}>{home.primaryCta} <Icon name="arrow" size={18} /></a>
          <a class="btn btn-ghost" href={localizePath(lang, '/contact')}>{home.secondaryCta}</a>
        </div>
        <ul class="trust">
          {
            x.trust.map((item) => (
              <li>
                <Icon name="check" size={16} />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="hero-visual">
        <EduPhone lang={lang} />
      </div>
    </div>
  </section>

  <SocialProof lang={lang} part="logos" />

  <section class="stack">
    <div class="container">
      <p class="stack-label">{home.stackLabel}</p>
      <div class="marquee">
        <ul class="chips">
          {home.stack.map((item) => <li>{item}</li>)}
        </ul>
        {
          [1, 2, 3].map(() => (
            <ul class="chips" aria-hidden="true">
              {home.stack.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  <StatsBand lang={lang} />

  <section class="section">
    <div class="container problems">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{x.kickers.problems}</span>
        <h2>{home.problemsHeading}</h2>
        <p class="lead">{home.problemsLead}</p>
        <blockquote class="principle">
          <p>“{home.principle}”</p>
          <cite>{home.principleBy}</cite>
        </blockquote>
      </div>
      <ol class="problem-list">
        {
          home.problems.map((p, i) => (
            <li class="card card-hover" data-reveal style={`--d:${i}`}>
              <span class="num">{i + 1}</span>
              <div>
                <h3>{p.title}</h3>
                <p class="muted">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{x.kickers.services}</span>
        <h2>{home.servicesHeading}</h2>
        <p class="lead">{home.servicesLead}</p>
      </div>
      <div class="bento">
        {
          bento.map((s, i) => (
            <a
              class:list={['card card-hover service', { wide: s.id === 'process-automation' || s.id === 'integration' }]}
              data-reveal
              style={`--d:${i % 3}`}
              href={servicePage(s.id) ? localizePath(lang, servicePage(s.id)) : `${localizePath(lang, '/services')}#${s.id}`}>
              <div class="service-text">
                <span class="icon">
                  <Icon name={serviceIcon(s.id)} />
                </span>
                <h3>{s.title}</h3>
                <p class="muted">{s.text}</p>
              </div>
              {s.id === 'process-automation' && (
                <div class="mini flow" aria-hidden="true">
                  <span class="mini-label">{x.flowLabel}</span>
                  <span class="flow-step trigger">
                    <Icon name="bell" size={16} />
                    {flow.trigger}
                  </span>
                  {flow.steps.map((step) => (
                    <span class="flow-step">
                      <Icon name="check" size={16} />
                      {step}
                    </span>
                  ))}
                </div>
              )}
              {s.id === 'integration' && (
                <div class="mini hub" aria-hidden="true">
                  <span class="mini-label">{x.hubLabel}</span>
                  <div class="hub-tree">
                    <span class="hub-core">
                      <Icon name="flow" size={22} />
                    </span>
                    <ul>
                      {home.stack.map((tool, j) => (
                        <li style={`--j:${j}`}>{tool}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}
              <span class="go" aria-hidden="true">
                <Icon name="arrow" size={18} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <SolutionsTeaser lang={lang} />

  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <span class="eyebrow">{x.kickers.process}</span>
        <h2>{services.processHeading}</h2>
      </div>
      <ol class="process">
        {
          services.process.map((step, i) => (
            <li data-reveal style={`--d:${i}`}>
              <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p class="muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <IntroVideo lang={lang} />

  {
    shown.length > 0 && (
      <section class="section product-section">
        <div class="container">
          <div class="section-head" data-reveal>
            <span class="eyebrow">{x.kickers.product}</span>
            <h2>{home.productHeading}</h2>
          </div>
          <div class="grid grid-2" data-reveal>
            {shown.map((p) => (
              <ProductCard product={p} lang={lang} />
            ))}
            {shown.some((p) => p.slug === 'sengetiedu') && (
              <ul class="edu-editions">
                {(['campus', 'senior', 'junior'] as const).map((e) => (
                  <li class={e}>
                    <a href={localizePath(lang, '/products/sengetiedu') + `#${e}`}>
                      <span class="ed-range">{sengetiEdu[lang].editions[e].range}</span>
                      <strong>{editionNames[e]}</strong>
                      <span class="muted">{sengetiEdu[lang].editions[e].text}</span>
                      <span class="ed-go" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    caseStudies.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head" data-reveal>
            <span class="eyebrow">{x.kickers.work}</span>
            <h2>{home.caseStudiesHeading}</h2>
          </div>
          <div class="grid grid-2">
            {caseStudies.map((post, i) => (
              <NewsCard post={post} lang={lang} index={i} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{x.kickers.why}</span>
        <h2>{home.whyHeading}</h2>
      </div>
      <div class="grid why">
        {
          home.why.map((w, i) => (
            <div class="card card-hover" data-reveal style={`--d:${i}`}>
              <span class="icon">
                <Icon name={whyIcons[i % whyIcons.length]} />
              </span>
              <h3>{w.title}</h3>
              <p class="muted">{w.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <SocialProof lang={lang} part="quotes" />

  <section class="section">
    <div class="container">
      <div class="cta-band" data-reveal>
        <h2>{home.ctaHeading}</h2>
        <p>{home.ctaText}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={localizePath(lang, '/start-project')}>{home.ctaButton} <Icon name="arrow" size={18} /></a>
          <a class="btn btn-ghost" href={localizePath(lang, '/school-demo')}>{schoolDemo[lang].nav}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(88vh, 760px);
    display: flex;
    align-items: center;
    padding-block: 96px 72px;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 56px;
    align-items: center;
  }

  .hero h1 {
    max-width: 17ch;
  }

  .hero .lead {
    margin-bottom: 2rem;
  }

  /* Announcement pill above the heading. */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    margin-bottom: 1.4rem;
    padding: 5px 14px 5px 5px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgb(var(--tint) / 0.04);
    box-shadow: inset 0 1px 0 rgb(var(--tint) / 0.05);
    color: var(--text);
    font-size: 0.88rem;
    text-decoration: none;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: hero-in 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .badge:hover {
    border-color: rgb(255 49 48 / 0.5);
    background: rgb(255 49 48 / 0.06);
  }

  .badge-tag {
    flex: none;
    padding: 3px 10px;
    border-radius: 999px;
    background: #d91c1b;
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .badge-text {
    min-width: 0;
  }

  .badge :global(svg) {
    flex: none;
    color: var(--red-text);
    transition: transform 0.2s;
  }

  .badge:hover :global(svg) {
    transform: translateX(3px);
  }

  .trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 28px 0 0;
    padding: 0;
    color: var(--muted);
    font-size: 0.9rem;
    animation: hero-in 0.45s 0.16s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .trust :global(svg) {
    color: var(--green);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .stack {
    padding-block: 8px 24px;
  }

  .stack-label {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 12px;
  }

  .problems {
    display: grid;
    gap: 40px;
    align-items: start;
  }

  .principle {
    margin: 28px 0 0;
    padding: 20px 24px;
    border-left: 3px solid var(--red);
    background: linear-gradient(90deg, var(--red-soft), transparent);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .principle p {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 6px;
  }

  .principle cite {
    color: var(--red-text);
    font-style: normal;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .problem-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
  }

  .problem-list li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 18px 20px;
  }

  .problem-list .num {
    flex: none;
    margin: 0;
  }

  .problem-list h3 {
    margin-bottom: 0.2em;
  }

  /* Services as a bento grid: two wide cards with small live-looking previews. */
  .bento {
    display: grid;
    gap: clamp(14px, 2vw, 20px);
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .bento {
      grid-template-columns: 1fr 1fr;
    }
    .bento .wide {
      grid-column: span 2;
    }
  }

  @media (min-width: 1040px) {
    .bento {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 20px;
    text-decoration: none;
    overflow: hidden;
  }

  .service h3 {
    margin-bottom: 0.35em;
  }

  .service p {
    margin: 0;
    font-size: 0.97rem;
  }

  .go {
    position: absolute;
    top: clamp(22px, 3vw, 32px);
    right: clamp(22px, 3vw, 32px);
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--border);
    color: var(--muted);
    transition: background-color 0.25s, color 0.25s, transform 0.25s, border-color 0.25s;
  }

  .service:hover .go {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
    transform: rotate(-45deg);
  }

  @media (min-width: 1040px) {
    .wide {
      flex-direction: row;
      align-items: stretch;
    }
    .wide .service-text {
      flex: 1 1 0;
      padding-right: 8px;
    }
    .wide .mini {
      flex: 1.1 1 0;
    }
    /* On wide cards the arrow sits under the text, clear of the preview. */
    .wide .go {
      top: auto;
      right: auto;
      bottom: clamp(22px, 3vw, 32px);
      left: clamp(22px, 3vw, 32px);
    }
    .wide .service-text {
      padding-bottom: 48px;
    }
  }

  .mini {
    position: relative;
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 16px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background:
      radial-gradient(circle at 100% 0%, rgb(255 49 48 / 0.1), transparent 60%),
      rgb(var(--shade) / 0.25);
    font-size: 0.85rem;
  }

  .mini-label {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  .flow-step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
  }

  .flow-step :global(svg) {
    flex: none;
    color: var(--green);
  }

  .flow-step.trigger {
    border-color: rgb(255 49 48 / 0.45);
    color: var(--white);
    font-weight: 600;
  }

  .flow-step.trigger :global(svg) {
    color: var(--red-text);
  }

  /* A short connector line between steps. */
  .flow-step + .flow-step::before {
    content: '';
    position: absolute;
    left: 19px;
    top: -9px;
    width: 2px;
    height: 9px;
    background: linear-gradient(var(--red), rgb(255 49 48 / 0.2));
  }

  .js .flow .flow-step {
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 0.4s,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .js .is-visible .flow .flow-step {
    opacity: 1;
    transform: none;
  }

  .js .is-visible .flow .flow-step:nth-of-type(2) { transition-delay: 0.25s; }
  .js .is-visible .flow .flow-step:nth-of-type(3) { transition-delay: 0.45s; }
  .js .is-visible .flow .flow-step:nth-of-type(4) { transition-delay: 0.65s; }
  .js .is-visible .flow .flow-step:nth-of-type(5) { transition-delay: 0.85s; }

  /* Systems integration: the Sengeti hub on the left, the client's tools branching off it. */
  .hub-tree {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0 22px;
  }

  .hub-core {
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: linear-gradient(180deg, #ff3e3d, #d91c1b);
    color: #fff;
    box-shadow:
      0 0 0 6px rgb(255 49 48 / 0.12),
      0 10px 30px -6px rgb(255 49 48 / 0.7);
  }

  /* A line from the hub to the trunk of the tree. */
  .hub-core::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 50%;
    width: 12px;
    height: 2px;
    background: var(--red);
  }

  .hub-tree ul {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 14px;
    display: grid;
    gap: 6px;
  }

  /* The trunk: runs from the first tool to the last. */
  .hub-tree ul::before {
    content: '';
    position: absolute;
    left: 0;
    top: 15px;
    bottom: 15px;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(rgb(255 49 48 / 0.3), var(--red), rgb(255 49 48 / 0.3));
  }

  .hub-tree li {
    position: relative;
    width: fit-content;
    padding: 4px 11px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .hub-tree li::before {
    content: '';
    position: absolute;
    right: 100%;
    top: 50%;
    width: 14px;
    height: 2px;
    background: rgb(255 49 48 / 0.55);
  }

  /* A pulse travels down the branches in turn. */
  .hub-tree li::after {
    content: '';
    position: absolute;
    right: calc(100% + 10px);
    top: calc(50% - 2px);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--red);
    opacity: 0;
    animation: ping 6s calc(var(--j) * 1s) ease-in-out infinite;
  }

  @keyframes ping {
    0%,
    100% {
      opacity: 0;
      transform: translateX(-4px);
    }
    6% {
      opacity: 1;
    }
    14% {
      opacity: 0;
      transform: translateX(10px);
    }
  }

  /* How it works: numbered steps joined by a thin line. */
  .process {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    counter-reset: step;
  }

  @media (min-width: 760px) {
    .process {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1040px) {
    .process {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
  }

  .process li {
    position: relative;
    padding: 24px 22px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: linear-gradient(180deg, rgb(var(--tint) / 0.035), transparent);
  }

  .process li::after {
    content: '';
    position: absolute;
    inset: -1px -1px auto;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--red), transparent);
  }

  .step-num {
    display: block;
    margin-bottom: 14px;
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    background: linear-gradient(180deg, var(--red-text), rgb(255 49 48 / 0.35));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .process h3 {
    margin-bottom: 0.4em;
  }

  .process p {
    margin: 0;
    font-size: 0.95rem;
  }

  .icon {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--red-soft);
    color: var(--red-text);
    margin-bottom: 18px;
  }

  .why {
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }

  @media (prefers-reduced-motion: reduce) {
    .js .flow .flow-step {
      opacity: 1;
      transform: none;
    }
  }

  .product-section {
    background: linear-gradient(180deg, transparent, rgb(255 49 48 / 0.06), transparent);
  }

  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: 1.25fr 1fr;
    }
    .problems {
      grid-template-columns: 1fr 1.1fr;
      gap: 64px;
    }
  }

  /* The three SengetiEdu editions beside the product card. */
  .edu-editions {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .edu-editions .campus {
    --c: var(--ed-campus);
    --ct: var(--ed-campus-text);
  }

  .edu-editions .senior {
    --c: var(--ed-senior);
    --ct: var(--ed-senior-text);
  }

  .edu-editions .junior {
    --c: var(--ed-junior);
    --ct: var(--ed-junior-text);
  }

