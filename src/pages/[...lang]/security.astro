---
import type { ComponentProps } from 'astro/types';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RedLight from '../../components/RedLight.astro';
import Icon from '../../components/Icon.astro';
import { langPaths, localizePath, type Lang } from '../../i18n';
import text from '../../i18n/pages/security';

type IconName = ComponentProps<typeof Icon>['name'];

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const page = text[lang];

// Lets Google show these questions directly in search results.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout lang={lang} title={page.title} description={page.description} path="/security" schema={schema}>
  <section class="page-hero hero">
    <RedLight variant="subtle" />
    <div class="dot-grid" aria-hidden="true"></div>
    <div class="container inner">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.heading} <span class="gradient-text">{page.headingAccent}</span></h1>
      <p class="lead">{page.lead}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>{page.practicesHeading}</h2>
        <p class="muted">{page.practicesLead}</p>
      </div>
      <div class="grid practices">
        {
          page.practices.map((p, i) => (
            <article class="card card-hover" data-reveal style={`--d:${i % 3}`}>
              <span class="icon">
                <Icon name={p.icon as IconName} size={24} />
              </span>
              <h3>{p.title}</h3>
              <p class="muted">{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>{page.controlHeading}</h2>
        <p class="muted">{page.controlLead}</p>
      </div>
      <div class="grid control">
        {
          page.control.map((c, i) => (
            <div class="item" data-reveal style={`--d:${i}`}>
              <span class="tick"><Icon name="check" size={18} /></span>
              <div>
                <h3>{c.title}</h3>
                <p class="muted">{c.text}</p>
              </div>
            </div>
          ))
        }
      </div>
      <div class="card law" data-reveal>
        <span class="icon"><Icon name="shield" size={24} /></span>
        <div>
          <h3>{page.lawHeading}</h3>
          <p class="muted">{page.lawText}</p>
          <a class="link" href={localizePath(lang, '/privacy')}>{page.privacyLink} <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 data-reveal>{page.faqHeading}</h2>
      <div class="faqs">
        {
          page.faqs.map((f, i) => (
            <details class="faq" data-reveal style={`--d:${i % 3}`}>
              <summary>{f.q}</summary>
              <p class="muted">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band" data-reveal>
        <h2>{page.ctaHeading}</h2>
        <p>{page.ctaText}</p>
        <a class="btn btn-primary" href={localizePath(lang, '/contact')}>{page.ctaButton}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .inner {
    position: relative;
    z-index: 1;
  }

  .hero h1 {
    max-width: 18ch;
  }

  .practices {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  .icon,
  .tick {
    display: inline-grid;
    place-items: center;
    flex: none;
    border-radius: 12px;
    background: var(--red-soft);
    color: var(--red-text);
  }

  .icon {
    width: 48px;
    height: 48px;
    margin-bottom: 16px;
  }

  .tick {
    width: 34px;
    height: 34px;
    border-radius: 50%;
  }

  .band {
    background: linear-gradient(180deg, transparent, rgb(255 49 48 / 0.06), transparent);
  }

  .control {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .item h3 {
    font-size: 1.1rem;
    margin-bottom: 0.3em;
  }

  .item p {
    margin: 0;
  }

  .law {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    align-items: flex-start;
  }

  .law > div {
    flex: 1 1 260px;
  }

  .law h3 {
    margin-bottom: 0.4em;
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--red-text);
    font-weight: 600;
    text-decoration: none;
  }

  .link:hover {
    text-decoration: underline;
  }

  .narrow {
    max-width: 820px;
  }
</style>
