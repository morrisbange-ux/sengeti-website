---
import type { ComponentProps } from 'astro/types';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RedLight from '../../components/RedLight.astro';
import Icon from '../../components/Icon.astro';
import { langPaths, localizePath, t, type Lang } from '../../i18n';
import text from '../../i18n/pages/technology';

type IconName = ComponentProps<typeof Icon>['name'];

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const page = text[lang];

/** Two-letter monogram that stands in for a logo, e.g. "Google Cloud" -> "GC". */
const mono = (name: string) => {
  const words = name.replace(/[^\p{L}\p{N} ]/gu, ' ').split(/\s+/).filter(Boolean);
  const letters = words.length > 1 ? words[0][0] + words[1][0] : (words[0] ?? '').slice(0, 2);
  return letters.toUpperCase();
};

// The first few names from each group, for the moving ribbon in the hero.
const ribbon = page.groups.flatMap((g) => g.items.slice(0, 3));
---

<BaseLayout lang={lang} title={page.title} description={page.description} path="/technology">
  <section class="page-hero hero">
    <RedLight variant="subtle" />
    <div class="dot-grid" aria-hidden="true"></div>
    <div class="container inner">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.heading} <span class="gradient-text">{page.headingAccent}</span></h1>
      <p class="lead">{page.lead}</p>
    </div>
    <div class="container inner ribbon-wrap">
      <p class="sr-only">{page.ribbonLabel}</p>
      <div class="marquee">
        <ul class="chips">{ribbon.map((r) => <li>{r}</li>)}</ul>
        <ul class="chips" aria-hidden="true">{ribbon.map((r) => <li>{r}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>{page.groupsHeading}</h2>
        <p class="muted">{page.groupsLead}</p>
      </div>
      <div class="grid groups">
        {
          page.groups.map((g, i) => (
            <article class="card card-hover group" data-reveal style={`--d:${i % 3}`}>
              <div class="group-head">
                <span class="icon">
                  <Icon name={g.icon as IconName} size={22} />
                </span>
                <div>
                  <h3>{g.title}</h3>
                  <p class="muted">{g.text}</p>
                </div>
              </div>
              <ul class="tech">
                {g.items.map((item, j) => (
                  <li style={`--i:${j}`}>
                    <span class="mono" aria-hidden="true">
                      {mono(item)}
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <div class="section-head" data-reveal><h2>{page.whyHeading}</h2></div>
      <div class="grid grid-3">
        {
          page.why.map((w, i) => (
            <div class="why" data-reveal style={`--d:${i}`}>
              <span class="icon">
                <Icon name={w.icon as IconName} size={22} />
              </span>
              <h3>{w.title}</h3>
              <p class="muted">{w.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band" data-reveal>
        <h2>{page.ctaHeading}</h2>
        <p>{page.ctaText}</p>
        <a class="btn btn-primary" href={localizePath(lang, '/start-project')}>{t(lang).nav.cta}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .inner {
    position: relative;
    z-index: 1;
  }

  .hero h1 {
    max-width: 18ch;
  }

  .ribbon-wrap {
    margin-top: clamp(28px, 5vw, 48px);
  }

  .groups {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  }

  .group-head {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-bottom: 18px;
  }

  .group-head h3 {
    margin-bottom: 0.2em;
  }

  .group-head p {
    margin: 0;
    font-size: 0.95rem;
  }

  .icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--red-soft);
    color: var(--red);
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tech li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    padding: 5px 12px 5px 5px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgb(var(--tint) / 0.03);
    color: var(--text);
    font-size: 0.88rem;
    transition:
      border-color 0.2s,
      background-color 0.2s,
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0s, 0s, calc(0.25s + var(--i) * 45ms), calc(0.25s + var(--i) * 45ms);
  }

  .tech li:hover {
    border-color: rgb(255 49 48 / 0.6);
    background: rgb(255 49 48 / 0.08);
  }

  .mono {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--red), #ff7a5c);
    color: var(--on-red);
    font-family: var(--font-display);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  /* Chips pop in one after another once their card scrolls into view. */
  :global(.js) .group:not(:global(.is-visible)) .tech li {
    opacity: 0;
    transform: translateY(10px) scale(0.9);
  }

  .band {
    background: linear-gradient(180deg, transparent, rgb(255 49 48 / 0.06), transparent);
  }

  .why .icon {
    margin-bottom: 14px;
  }

  .why h3 {
    margin-bottom: 0.3em;
  }

  .why p {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .group:not(:global(.is-visible)) .tech li {
      opacity: 1;
      transform: none;
    }
  }
</style>
