---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RedLight from '../../components/RedLight.astro';
import ContactForm from '../../components/ContactForm.astro';
import ContactChannels from '../../components/ContactChannels.astro';
import { langPaths, t, type Lang } from '../../i18n';
import { site } from '../../config/site';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const { support, extras } = t(lang);

// Lets Google show these questions directly in search results.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: support.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout lang={lang} title={support.title} description={support.description} path="/support" schema={schema}>
  <section class="page-hero hero">
    <RedLight variant="subtle" />
    <div class="container inner">
      <h1>{support.heading}</h1>
      <p class="lead">{support.lead}</p>
    </div>
  </section>

  <section class="section top0">
    <div class="container">
      <h2 class="sr-only">{support.channelsHeading}</h2>
      <ContactChannels
        lang={lang}
        showLocation={false}
        notes={{ whatsapp: support.whatsappText, email: support.emailText }}
      />
      <div class="response" data-reveal>
        <h2>{extras.responseHeading}</h2>
        <ul>
          <li>
            <span class="dot urgent"></span>
            {extras.responseUrgent.replace('{n}', String(site.responseTimes.urgentHours))}
          </li>
          <li>
            <span class="dot"></span>
            {(site.responseTimes.normalDays === 1 ? extras.responseNormal : extras.responseNormalMany).replace(
              '{n}',
              String(site.responseTimes.normalDays),
            )}
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container layout">
      <div>
        <h2 data-reveal>{support.faqHeading}</h2>
        <div class="faqs">
          {
            support.faqs.map((f, i) => (
              <details class="faq" data-reveal style={`--d:${i % 3}`}>
                <summary>{f.q}</summary>
                <p class="muted">{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
      <ContactForm lang={lang} heading={support.formHeading} subjects={support.subjects} emailSubject="Support request" />
    </div>
  </section>
</BaseLayout>

<style>
  .response {
    margin-top: 16px;
    padding: 20px 24px;
    border-left: 3px solid var(--red);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: linear-gradient(90deg, var(--red-soft), transparent);
  }

  .response h2 {
    font-size: 1.2rem;
  }

  .response ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .response li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--green);
  }

  .dot.urgent {
    background: var(--red);
  }

  .hero {
    position: relative;
    overflow: hidden;
  }

  .inner {
    position: relative;
    z-index: 1;
  }

  .top0 {
    padding-top: 16px;
    padding-bottom: 0;
  }

  .top0 :global(.channels) {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .layout {
    display: grid;
    gap: 40px;
    align-items: start;
  }


  @media (min-width: 960px) {
    .layout {
      grid-template-columns: 1.2fr 1fr;
    }
  }
</style>
