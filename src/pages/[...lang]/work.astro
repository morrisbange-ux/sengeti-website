---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RedLight from '../../components/RedLight.astro';
import Icon from '../../components/Icon.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { langPaths, localizePath, t, type Lang } from '../../i18n';
import work from '../../i18n/pages/work';
import { getProjects } from '../../lib/content';
import { site } from '../../config/site';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const tx = work[lang];
const projects = await getProjects(lang);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: tx.title,
    description: tx.description,
    url: `${site.url}${localizePath(lang, '/work')}`,
    hasPart: projects.map((p) => ({
      '@type': 'CreativeWork',
      name: p.data.title,
      description: p.data.summary,
      dateCreated: String(p.data.year),
      creator: { '@id': `${site.url}/#organization` },
    })),
  },
];
---

<BaseLayout lang={lang} title={tx.title} description={tx.description} path="/work" schema={schema}>
  <section class="page-hero hero">
    <RedLight variant="subtle" />
    <div class="dot-grid" aria-hidden="true"></div>
    <div class="container inner">
      <span class="eyebrow">{tx.eyebrow}</span>
      <h1>{tx.heading} <span class="gradient-text">{tx.headingAccent}</span></h1>
      <p class="lead">{tx.lead}</p>
    </div>
  </section>

  <section class="section top0">
    <div class="container list">
      {
        projects.map((p, i) => (
          <article class="project" data-reveal>
            <div class="visual">
              {p.data.cover ? (
                <Image src={p.data.cover} alt={p.data.coverAlt} width={720} class="cover" />
              ) : (
                <ProjectVisual kind={p.data.visual} />
              )}
            </div>
            <div class="copy">
              <span class="eyebrow">
                {String(i + 1).padStart(2, '0')} · {p.data.sector}
              </span>
              <h2>{p.data.title}</h2>
              <p class="muted">{p.data.summary}</p>
              <dl class="facts">
                <div>
                  <dt>{tx.client}</dt>
                  <dd>{p.data.client}</dd>
                </div>
                <div>
                  <dt>{tx.year}</dt>
                  <dd>{p.data.year}</dd>
                </div>
              </dl>
              {p.data.results.length > 0 && (
                <ul class="ticks">
                  {p.data.results.map((r) => (
                    <li>{r}</li>
                  ))}
                </ul>
              )}
              <ul class="chips" aria-label={tx.tech}>
                {[...p.data.services, ...p.data.tech].map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
              <div class="links">
                {p.data.caseStudy && (
                  <a class="more" href={localizePath(lang, `/news/${p.data.caseStudy}`)}>
                    {tx.caseStudy} <Icon name="arrow" size={18} />
                  </a>
                )}
                {p.data.product && (
                  <a class="more" href={localizePath(lang, `/products/${p.data.product}`)}>
                    {tx.product} <Icon name="arrow" size={18} />
                  </a>
                )}
                {p.data.url && !p.data.url.startsWith(site.url) && (
                  <a class="more" href={p.data.url} target="_blank" rel="noopener">
                    {tx.visit} <Icon name="arrow" size={18} />
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band" data-reveal>
        <h2>{tx.ctaHeading}</h2>
        <p>{tx.ctaText}</p>
        <a class="btn btn-primary" href={localizePath(lang, '/start-project')}>{t(lang).nav.cta}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .inner {
    position: relative;
    z-index: 1;
  }

  .top0 {
    padding-top: 24px;
  }

  .list {
    display: grid;
    gap: clamp(48px, 8vw, 96px);
  }

  .project {
    display: grid;
    gap: 32px;
    align-items: center;
  }

  .cover {
    border-radius: 14px;
    border: 1px solid var(--border);
  }

  .project h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .facts {
    display: flex;
    gap: 32px;
    margin: 0 0 8px;
  }

  .facts dt {
    font-size: 0.8rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .facts dd {
    margin: 0;
    color: var(--white);
    font-weight: 600;
  }

  .chips {
    margin-top: 18px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 22px;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--red);
    font-weight: 700;
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }

  @media (min-width: 900px) {
    .project {
      grid-template-columns: 1.1fr 1fr;
      gap: 56px;
    }
    .project:nth-child(even) .visual {
      order: 2;
    }
  }
</style>
