---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RedLight from '../../../components/RedLight.astro';
import Icon from '../../../components/Icon.astro';
import { defaultLang, langs, localizePath, t, type Lang } from '../../../i18n';
import industries, { industryIcons, industrySlugs, type IndustrySlug } from '../../../i18n/pages/industries';
import { site, whatsappLink } from '../../../config/site';

export function getStaticPaths() {
  return langs.flatMap((lang) =>
    industrySlugs.map((slug) => ({
      params: { lang: lang === defaultLang ? undefined : lang, slug },
      props: { lang, slug },
    })),
  );
}

const { lang, slug } = Astro.props as { lang: Lang; slug: IndustrySlug };
const dict = t(lang);
const copy = industries[lang];
const { labels } = copy;
const item = copy.items[slug];
const spotlight = 'spotlight' in item ? item.spotlight : undefined;
const path = `/industries/${slug}`;
const url = `${site.url}${localizePath(lang, path)}`;
const others = industrySlugs.filter((s) => s !== slug);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: item.heading,
    serviceType: item.eyebrow,
    description: item.description,
    url,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: site.areaServed,
    audience: { '@type': 'Audience', audienceType: item.audience },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: labels.buildHeading,
      itemListElement: item.builds.map((b) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: b.title, description: b.text },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: item.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: dict.nav.home, item: `${site.url}${localizePath(lang, '/')}` },
      { '@type': 'ListItem', position: 2, name: labels.industries, item: `${site.url}${localizePath(lang, '/industries')}` },
      { '@type': 'ListItem', position: 3, name: item.name, item: url },
    ],
  },
];
---

<BaseLayout lang={lang} title={item.title} description={item.description} path={path} schema={schema}>
  <section class="page-hero hero">
    <RedLight variant="subtle" />
    <div class="dot-grid" aria-hidden="true"></div>
    <div class="container inner">
      <div>
        <a class="back" href={localizePath(lang, '/industries')}>← {labels.allIndustries}</a>
        <span class="eyebrow">{item.eyebrow}</span>
        <h1>{item.heading} <span class="gradient-text">{item.headingAccent}</span></h1>
        <p class="lead">{item.lead}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={localizePath(lang, '/start-project')}>{dict.nav.cta}</a>
          <a class="btn btn-ghost" href={whatsappLink(dict.contact.whatsappMessage)} target="_blank" rel="noopener"
            >{dict.contact.whatsappButton}</a
          >
        </div>
      </div>
      <aside class="glance card" aria-label={item.name}>
        <div class="glance-head">
          <span class="icon"><Icon name={industryIcons[slug]} size={24} /></span>
          <strong>{item.name}</strong>
        </div>
        <ul class="glance-list">
          {
            item.points.map((p) => (
              <li>
                <span class="check"><Icon name="check" size={16} /></span>
                {p}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  {
    spotlight && (
      <section class="section">
        <div class="container">
          <div class="spotlight" data-reveal>
            <div>
              <span class="eyebrow">{spotlight.eyebrow}</span>
              <h2>{spotlight.heading}</h2>
              <p class="muted">{spotlight.text}</p>
              <div class="btn-row">
                <a class="btn btn-primary" href={localizePath(lang, '/products/attendance')}>{spotlight.productCta}</a>
                <a class="btn btn-ghost" href={localizePath(lang, '/news/university-attendance')}>{spotlight.caseCta}</a>
              </div>
            </div>
            <ul class="spot-points">
              {spotlight.points.map((p, i) => (
                <li data-reveal style={`--d:${i}`}>
                  <span class="check">
                    <Icon name="check" size={16} />
                  </span>
                  {p}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal><h2>{labels.challengesHeading}</h2></div>
      <div class="grid challenges">
        {
          item.challenges.map((c, i) => (
            <article class="card" data-reveal style={`--d:${i % 4}`}>
              <span class="num">{i + 1}</span>
              <h3>{c.title}</h3>
              <p class="muted">{c.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <div class="section-head" data-reveal><h2>{labels.buildHeading}</h2></div>
      <div class="grid grid-3">
        {
          item.builds.map((b, i) => (
            <a class="card card-hover build" href={localizePath(lang, b.href)} data-reveal style={`--d:${i % 3}`}>
              <h3>{b.title}</h3>
              <p class="muted">{b.text}</p>
              <span class="more">
                {labels.learnMore} <Icon name="arrow" size={18} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 data-reveal>{labels.faqHeading}</h2>
      <div class="faqs">
        {
          item.faqs.map((f, i) => (
            <details class="faq" data-reveal style={`--d:${i}`}>
              <summary>{f.q}</summary>
              <p class="muted">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band" data-reveal>
        <h2>{labels.ctaHeading}</h2>
        <p>{labels.ctaText}</p>
        <div class="btn-row center">
          <a class="btn btn-primary" href={localizePath(lang, '/start-project')}>{dict.nav.cta}</a>
          <a class="btn btn-ghost" href={whatsappLink(dict.contact.whatsappMessage)} target="_blank" rel="noopener"
            >{dict.contact.whatsappButton}</a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="section top0">
    <div class="container">
      <h2 class="others-heading">{labels.otherIndustries}</h2>
      <ul class="chips others">
        {
          others.map((s) => (
            <li>
              <a href={localizePath(lang, `/industries/${s}`)}>{copy.items[s].name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .inner > * {
    min-width: 0;
  }

  .hero h1 {
    max-width: 20ch;
    overflow-wrap: break-word;
  }

  .back {
    display: block;
    width: fit-content;
    margin-bottom: 20px;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--white);
  }

  .glance {
    box-shadow: 0 30px 80px -30px rgb(255 49 48 / 0.45);
  }

  .glance-head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--border);
    font-size: 1.1rem;
  }

  .glance-head .icon {
    margin: 0;
    flex: none;
  }

  .glance-list,
  .spot-points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
  }

  .glance-list li,
  .spot-points li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .icon {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--red-soft);
    color: var(--red-text);
    margin-bottom: 16px;
  }

  .check {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--red-soft);
    color: var(--red-text);
  }

  .spotlight {
    display: grid;
    gap: 32px;
    align-items: center;
    border: 1px solid rgb(255 49 48 / 0.35);
    border-radius: calc(var(--radius) * 1.5);
    padding: clamp(24px, 5vw, 56px);
    background:
      radial-gradient(ellipse 70% 100% at 100% 0%, rgb(255 49 48 / 0.22), transparent 70%),
      var(--surface);
  }

  .spotlight h2 {
    margin-top: 0.4rem;
  }

  .spotlight .muted {
    margin-bottom: 1.6rem;
  }

  .spot-points li {
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgb(var(--tint) / 0.03);
  }

  .challenges {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
  }

  .band {
    background: linear-gradient(180deg, transparent, rgb(255 49 48 / 0.06), transparent);
  }

  .build {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .build .muted {
    margin-bottom: 1.2rem;
  }

  .more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--red-text);
    font-weight: 600;
  }

  .more :global(svg) {
    transition: transform 0.25s;
  }

  .build:hover .more :global(svg),
  .build:focus-visible .more :global(svg) {
    transform: translateX(4px);
  }

  .narrow {
    max-width: 820px;
  }

  .center {
    justify-content: center;
  }

  .top0 {
    padding-top: 0;
  }

  .others-heading {
    font-size: 1.3rem;
  }

  .chips.others li {
    padding: 0;
  }

  .others a {
    display: block;
    padding: 7px 14px;
    color: inherit;
    text-decoration: none;
  }

  .others li:has(a:hover),
  .others li:has(a:focus-visible) {
    border-color: rgb(255 49 48 / 0.55);
    color: var(--white);
  }

  @media (min-width: 960px) {
    .inner {
      grid-template-columns: 1.4fr 1fr;
    }

    .spotlight {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .more :global(svg) {
      transition: none;
    }

    .build:hover .more :global(svg),
    .build:focus-visible .more :global(svg) {
      transform: none;
    }
  }
</style>
