---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RedLight from '../../components/RedLight.astro';
import { Image } from 'astro:assets';
import mark from '../../assets/brand/sengeti-mark.png';
import { langPaths, localizePath, t, type Lang } from '../../i18n';
import { site } from '../../config/site';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const dict = t(lang);
const { about } = dict;
---

<BaseLayout lang={lang} title={about.title} description={about.description} path="/about">
  <section class="page-hero section-hero">
    <RedLight variant="subtle" />
    <div class="container inner">
      <h1>{about.heading}</h1>
      <p class="lead">{about.lead}</p>
    </div>
  </section>

  <section class="section">
    <div class="container story" data-reveal>
      <div>
        <h2>{about.storyHeading}</h2>
        {about.story.map((p) => <p class="muted">{p}</p>)}
      </div>
      <div class="mark">
        <Image src={mark} alt="" width={180} densities={[1, 2]} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{about.valuesHeading}</h2>
      </div>
      <div class="grid grid-2">
        {
          about.values.map((v, i) => (
            <div class="card card-hover" data-reveal style={`--d:${i % 2}`}>
              <span class="num">{i + 1}</span>
              <h3>{v.title}</h3>
              <p class="muted">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card founder" data-reveal>
        <div class="initials" aria-hidden="true">MB</div>
        <div>
          <span class="eyebrow">{about.founderHeading}</span>
          <h2>{site.founder}</h2>
          <p class="muted">{about.founderRole}, {site.name} · {site.country}</p>
          <p>{about.founderText}</p>
          <a class="btn btn-ghost" href={localizePath(lang, '/contact')}>{dict.nav.cta}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-hero {
    position: relative;
    overflow: hidden;
  }

  .inner {
    position: relative;
    z-index: 1;
  }

  .story {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .mark {
    display: flex;
    justify-content: center;
  }

  .mark img {
    width: 140px;
    filter: drop-shadow(0 0 40px rgb(255 49 48 / 0.45));
  }

  .founder {
    display: grid;
    gap: 28px;
    align-items: center;
  }

  .initials {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--white);
    background: radial-gradient(circle at 30% 30%, #ff6a4d, var(--red) 55%, #8a1010);
  }

  @media (min-width: 800px) {
    .story {
      grid-template-columns: 2fr 1fr;
    }
    .mark img {
      width: 180px;
    }
    .founder {
      grid-template-columns: auto 1fr;
      gap: 40px;
    }
  }
</style>
