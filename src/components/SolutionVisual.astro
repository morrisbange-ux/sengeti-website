---
/**
 * Illustrations for the solution pages, drawn in HTML and CSS so they cost no
 * image downloads. "ai" shows a document being read into data, "erp" a live
 * dashboard, "automation" a workflow running step by step and "software" code
 * being written and shipped.
 */
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  kind: 'ai' | 'erp' | 'automation' | 'software';
}
const { lang, kind } = Astro.props;
const { solutions } = t(lang);
const ai = solutions.ai.visual;
const erp = solutions.erp.visual;
const auto = solutions.automation.visual;
const soft = solutions.software.visual;
const bars = [46, 62, 54, 78, 70, 92];

// Code shown in the software illustration: [indent, [class, text][]].
const code: [number, [string, string][]][] = [
  [0, [['k', 'const '], ['v', 'session'], ['p', ' = '], ['k', 'await '], ['f', 'createSession'], ['p', '({']]],
  [1, [['v', 'course'], ['p', ': '], ['s', "'CS 201'"], ['p', ',']]],
  [1, [['v', 'qr'], ['p', ': '], ['f', 'rotating'], ['p', '({ '], ['v', 'every'], ['p', ': '], ['n', '15'], ['p', ' }),']]],
  [0, [['p', '});']]],
  [0, []],
  [0, [['v', 'session'], ['p', '.'], ['f', 'on'], ['p', '('], ['s', "'check-in'"], ['p', ', ('], ['v', 'student'], ['p', ') => {']]],
  [1, [['v', 'roster'], ['p', '.'], ['f', 'mark'], ['p', '('], ['v', 'student'], ['p', ', '], ['s', "'present'"], ['p', ');']]],
  [1, [['f', 'notify'], ['p', '('], ['v', 'student'], ['p', '.'], ['v', 'phone'], ['p', ');']]],
  [0, [['p', '});']]],
];
---

<div class={`visual ${kind}`} aria-hidden="true">
  {
    kind === 'ai' ? (
      <div class="ai-wrap">
        <div class="doc">
          <div class="doc-head">
            <Icon name="doc" size={18} />
            <span>{ai.file}</span>
          </div>
          <div class="lines">
            <i style="width:62%" />
            <i style="width:88%" />
            <i style="width:74%" />
            <i style="width:80%" />
            <i style="width:46%" />
            <i style="width:70%" />
          </div>
          <span class="scan" />
        </div>
        <div class="fields">
          <p class="reading">
            <span class="spark">
              <Icon name="bolt" size={16} />
            </span>
            {ai.reading}
          </p>
          {ai.fields.map((f, i) => (
            <div class="field" style={`--i:${i}`}>
              <span>{f.label}</span>
              <strong>{f.value}</strong>
            </div>
          ))}
          <p class="done">
            <Icon name="check" size={16} /> {ai.done}
          </p>
        </div>
      </div>
    ) : kind === 'automation' ? (
      <div class="flow">
        <div class="trigger">
          <span class="spark">
            <Icon name="bolt" size={16} />
          </span>
          {auto.trigger}
        </div>
        <ol class="flow-steps">
          <span class="pulse" />
          {auto.steps.map((step, i) => (
            <li style={`--i:${i}`}>
              <span class="node">
                <Icon name="check" size={14} />
              </span>
              {step}
            </li>
          ))}
        </ol>
        <div class="saved">
          <span>{auto.saved}</span>
          <strong>{auto.savedValue}</strong>
        </div>
      </div>
    ) : kind === 'software' ? (
      <div class="editor force-dark">
        <div class="win-bar">
          <i />
          <i />
          <i />
          <span class="tab">{soft.file}</span>
        </div>
        <pre class="code"><code>{code.map(([indent, tokens], i) => (
          <span class="ln" style={`--i:${i};--w:${Math.max(1, indent * 2 + tokens.reduce((n, [, t]) => n + t.length, 0))}ch;--steps:${Math.max(1, tokens.reduce((n, [, t]) => n + t.length, 0))}`}><span class="no">{i + 1}</span>{'  '.repeat(indent)}{tokens.map(([c, t]) => <span class={c}>{t}</span>)}</span>
        ))}<span class="caret" /></code></pre>
        <div class="term">
          <p class="t1">
            <Icon name="check" size={14} /> {soft.status}
          </p>
          <p class="t2">
            <span class="live" /> {soft.deployed}
          </p>
        </div>
      </div>
    ) : (
      <div class="dash">
        <p class="dash-title">
          <Icon name="chart" size={18} /> {erp.title}
        </p>
        <div class="kpis">
          {erp.kpis.map((k) => (
            <div class="kpi">
              <span>{k.label}</span>
              <strong>{k.value}</strong>
            </div>
          ))}
        </div>
        <div class="chart">
          <span class="label">{erp.chart}</span>
          <div class="bars">
            {bars.map((h, i) => (
              <div class="bar">
                <i style={`--h:${h}%;--i:${i}`} />
                <span>{erp.days[i]}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="approvals">
          <span class="label">{erp.approvals}</span>
          {erp.items.map((item) => (
            <p>
              <span class="dot" />
              {item}
              <span class="ok">
                <Icon name="check" size={14} />
              </span>
            </p>
          ))}
        </div>
      </div>
    )
  }
</div>

<style>
  .visual {
    width: 100%;
    max-width: 460px;
    margin-inline: auto;
    padding: 20px;
    border-radius: 20px;
    border: 1px solid var(--border);
    background:
      radial-gradient(ellipse 90% 70% at 80% 0%, rgb(255 49 48 / 0.18), transparent 70%),
      linear-gradient(180deg, var(--surface-2), var(--surface));
    box-shadow: 0 30px 70px -30px rgb(255 49 48 / 0.45);
    font-size: 0.88rem;
  }

  .label,
  .kpi span,
  .field span {
    color: var(--muted);
    font-size: 0.78rem;
  }

  /* AI: a document being read into fields. */
  .ai-wrap {
    display: grid;
    grid-template-columns: 0.9fr 1fr;
    gap: 16px;
    align-items: start;
  }

  .doc {
    position: relative;
    overflow: hidden;
    padding: 14px;
    border-radius: 12px;
    background: #f4f4f5;
    color: #3f3f46;
    min-height: 210px;
  }

  .doc-head {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--red);
    margin-bottom: 14px;
    word-break: break-all;
  }

  .lines i {
    display: block;
    height: 7px;
    margin-bottom: 11px;
    border-radius: 4px;
    background: #d4d4d8;
  }

  .scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 36px;
    background: linear-gradient(180deg, transparent, rgb(255 49 48 / 0.35), transparent);
    border-bottom: 2px solid var(--red);
    animation: scan 3.2s ease-in-out infinite;
  }

  .fields {
    display: grid;
    gap: 8px;
  }

  .reading {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 2px;
    color: var(--white);
    font-weight: 600;
  }

  .spark {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: var(--red);
    color: var(--on-red);
  }

  .field {
    padding: 8px 10px;
    border-radius: 10px;
    background: rgb(var(--tint) / 0.04);
    border: 1px solid var(--border);
    animation: rise 0.5s calc(0.25s * var(--i)) both;
  }

  .field span,
  .kpi span {
    display: block;
  }

  .field strong {
    color: var(--white);
  }

  .done {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 4px 0 0;
    color: var(--green);
    font-weight: 600;
  }

  /* ERP: a live dashboard. */
  .dash-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    color: var(--white);
    font-weight: 600;
  }

  .dash-title :global(svg) {
    color: var(--red);
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 12px;
  }

  .kpi {
    padding: 10px;
    border-radius: 10px;
    background: rgb(var(--tint) / 0.04);
    border: 1px solid var(--border);
  }

  .kpi strong {
    display: block;
    color: var(--white);
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .kpi:first-child strong {
    color: var(--red);
  }

  .chart,
  .approvals {
    padding: 12px;
    border-radius: 12px;
    background: rgb(var(--shade) / 0.25);
    border: 1px solid var(--border);
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    height: 110px;
    margin-top: 10px;
  }

  .bar {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 6px;
  }

  .bar i {
    display: block;
    width: 100%;
    height: var(--h);
    border-radius: 6px 6px 2px 2px;
    background: linear-gradient(180deg, #ff7a5c, var(--red));
    transform-origin: bottom;
    animation: grow 0.8s calc(0.1s * var(--i)) both;
  }

  .bar span {
    font-size: 0.7rem;
    color: var(--muted);
  }

  .approvals {
    margin-top: 10px;
  }

  .approvals p {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 8px 0 0;
    color: var(--text);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fbbf24;
    flex: none;
  }

  .ok {
    margin-left: auto;
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgb(110 231 160 / 0.15);
    color: var(--green);
    flex: none;
  }

  /* Automation: a workflow running step by step. */
  .trigger {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 12px;
    background: rgb(255 49 48 / 0.12);
    border: 1px solid rgb(255 49 48 / 0.4);
    color: var(--white);
    font-weight: 600;
  }

  .flow-steps {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 14px 0 6px 0;
    display: grid;
    gap: 10px;
  }

  /* The line joining the steps, with a pulse travelling down it. */
  .flow-steps::before {
    content: '';
    position: absolute;
    left: 18px;
    top: 0;
    bottom: 22px;
    width: 2px;
    background: var(--border);
  }

  .pulse {
    position: absolute;
    left: 14px;
    top: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 14px 4px rgb(255 49 48 / 0.7);
    animation: travel 6s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }

  .flow-steps li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px 10px 4px;
    border-radius: 10px;
    color: var(--muted);
    animation: step 6s calc(0.9s + var(--i) * 1s) infinite;
  }

  .node {
    position: relative;
    z-index: 1;
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: transparent;
    animation: node 6s calc(0.9s + var(--i) * 1s) infinite;
  }

  .saved {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    padding: 12px 14px;
    border-radius: 12px;
    background: rgb(var(--shade) / 0.25);
    border: 1px solid var(--border);
    color: var(--muted);
  }

  .saved strong {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--green);
  }

  /* Software: code being written, tested and shipped. */
  .editor {
    border-radius: 14px;
    overflow: hidden;
    background: #0d0d10;
    border: 1px solid var(--border);
  }

  .win-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    background: rgb(var(--tint) / 0.04);
    border-bottom: 1px solid var(--border);
  }

  .win-bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3f3f46;
  }

  .win-bar i:first-child {
    background: var(--red);
  }

  .tab {
    margin-left: 10px;
    padding: 3px 10px;
    border-radius: 6px;
    background: rgb(var(--tint) / 0.06);
    color: var(--text);
    font-size: 0.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .code {
    margin: 0;
    padding: 14px 14px 10px 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: clamp(0.66rem, 1.7vw, 0.76rem);
    line-height: 1.7;
    color: #d4d4d8;
    overflow: hidden;
  }

  .ln {
    display: block;
    white-space: pre;
    overflow: hidden;
    width: calc(var(--w) + 5ch);
    max-width: 100%;
    animation: type calc(var(--steps) * 28ms) steps(var(--steps)) calc(0.3s + var(--i) * 0.42s) both;
  }

  .no {
    display: inline-block;
    width: 3ch;
    margin-right: 1.4ch;
    text-align: right;
    color: #52525b;
  }

  .k {
    color: #ff6b6b;
  }

  .f {
    color: #fbbf24;
  }

  .s {
    color: var(--green);
  }

  .n {
    color: #c4b5fd;
  }

  .v {
    color: #e4e4e7;
  }

  .p {
    color: #a1a1aa;
  }

  .caret {
    display: inline-block;
    width: 7px;
    height: 1.1em;
    margin-left: 4.4ch;
    vertical-align: -0.2em;
    background: var(--red);
    animation: blink 1s steps(1) infinite;
  }

  .term {
    padding: 10px 14px 14px;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
  }

  .term p {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    animation: rise 0.5s both;
  }

  .t1 {
    color: var(--green);
    animation-delay: 4.4s !important;
  }

  .t2 {
    margin-top: 6px !important;
    color: var(--white);
    animation-delay: 5s !important;
  }

  .live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 0 rgb(110 231 160 / 0.6);
    animation: ping 1.8s ease-out infinite;
  }

  @keyframes travel {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    80% {
      transform: translateY(200px);
      opacity: 1;
    }
    100% {
      transform: translateY(200px);
      opacity: 0;
    }
  }

  @keyframes step {
    0% {
      color: var(--muted);
      background: transparent;
    }
    6%,
    70% {
      color: var(--white);
      background: rgb(var(--tint) / 0.04);
    }
    90%,
    100% {
      color: var(--muted);
      background: transparent;
    }
  }

  @keyframes node {
    0% {
      background: var(--surface-2);
      color: transparent;
      border-color: var(--border);
    }
    6%,
    70% {
      background: var(--red);
      color: var(--on-red);
      border-color: var(--red);
    }
    90%,
    100% {
      background: var(--surface-2);
      color: transparent;
      border-color: var(--border);
    }
  }

  @keyframes type {
    from {
      width: 4.4ch;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes ping {
    70%,
    100% {
      box-shadow: 0 0 0 8px rgb(110 231 160 / 0);
    }
  }

  @keyframes scan {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(180px);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }

  @media (max-width: 420px) {
    .ai-wrap {
      grid-template-columns: 1fr;
    }
    .doc {
      min-height: 150px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scan,
    .field,
    .bar i,
    .pulse,
    .ln,
    .caret,
    .term p,
    .live {
      animation: none;
    }
    .flow-steps li,
    .node {
      animation: none;
    }
    .flow-steps li {
      color: var(--white);
    }
    .node {
      background: var(--red);
      border-color: var(--red);
      color: var(--on-red);
    }
  }
</style>
