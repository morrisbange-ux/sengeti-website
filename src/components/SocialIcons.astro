---
import { socialLinks, type SocialNetwork } from '../config/site';

const paths: Record<SocialNetwork, string> = {
  facebook:
    'M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9z',
  linkedin:
    'M6.9 8.8H3.8V20h3.1V8.8zM5.4 3.5a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6zM20.2 13.6c0-3-1.6-5-4.3-5-1.4 0-2.4.8-2.8 1.5V8.8H10V20h3.1v-5.6c0-1.5.3-2.9 2.1-2.9 1.8 0 1.8 1.7 1.8 3V20h3.1v-6.4z',
  instagram:
    'M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm4.9-8.9a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2zM12 3.6c-2.3 0-2.6 0-3.5.1-3.1.1-4.6 1.6-4.7 4.7-.1.9-.1 1.2-.1 3.6s0 2.7.1 3.6c.1 3.1 1.6 4.6 4.7 4.7.9.1 1.2.1 3.5.1s2.6 0 3.5-.1c3.1-.1 4.6-1.6 4.7-4.7.1-.9.1-1.2.1-3.6s0-2.7-.1-3.6c-.1-3.1-1.6-4.6-4.7-4.7-.9-.1-1.2-.1-3.5-.1z',
  x: 'M17.5 3.5h3l-6.6 7.5 7.8 9.5h-6.1l-4.8-5.9-5.4 5.9h-3l7-7.9L2 3.5h6.2l4.3 5.4 5-5.4zm-1 15.3h1.7L7.6 5.1H5.8l10.7 13.7z',
  youtube:
    'M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.3 5 12 5 12 5s-6.3 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8c1.5.4 7.8.4 7.8.4s6.3 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3L10 15z',
  tiktok:
    'M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V9.7a5.8 5.8 0 1 0 5 5.7V9.1a7.3 7.3 0 0 0 4.3 1.4V7.4a4.3 4.3 0 0 1-3.3-1.6z',
};

interface Props {
  size?: number;
}
const { size = 20 } = Astro.props;
const links = socialLinks();
---

{
  links.length > 0 && (
    <ul class="social">
      {links.map((s) => (
        <li>
          <a href={s.href} rel="noopener me" target="_blank" aria-label={s.label} title={s.label}>
            <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={paths[s.network]} />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .social {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border);
    color: var(--text);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }

  a:hover {
    background: var(--red);
    border-color: var(--red);
    color: var(--on-red);
  }
</style>
