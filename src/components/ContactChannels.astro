---
/** WhatsApp, phone, email and location cards, shared by Contact and Support. */
import Icon from './Icon.astro';
import SocialIcons from './SocialIcons.astro';
import { t, type Lang } from '../i18n';
import { phoneLink, site, socialLinks, whatsappLink } from '../config/site';

interface Props {
  lang: Lang;
  /** Short explanations under each channel (Support page). */
  notes?: { whatsapp?: string; email?: string; phone?: string };
  showLocation?: boolean;
}
const { lang, notes = {}, showLocation = true } = Astro.props;
const { contact } = t(lang);
---

<div class="channels">
  <div class="card">
    <h2>{contact.phoneHeading}</h2>
    {notes.whatsapp && <p class="muted note">{notes.whatsapp}</p>}
    <p><a class="big" href={phoneLink()}>{site.phone}</a></p>
    <a class="btn btn-whatsapp" href={whatsappLink(contact.whatsappMessage)} target="_blank" rel="noopener">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"
        ><path
          d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3z"
        ></path></svg
      >
      {contact.whatsappButton}
    </a>
  </div>
  <div class="card">
    <h2>{contact.emailHeading}</h2>
    {notes.email && <p class="muted note">{notes.email}</p>}
    <p><a class="big" href={`mailto:${site.email}`}><Icon name="mail" size={20} /> {site.email}</a></p>
  </div>
  {
    showLocation && (
      <div class="card">
        <h2>{contact.locationHeading}</h2>
        <p class="muted">{site.city}, {site.country}</p>
      </div>
    )
  }
  {
    showLocation && socialLinks().length > 0 && (
      <div class="card">
        <h2>{contact.socialHeading}</h2>
        <SocialIcons />
      </div>
    )
  }
</div>

<style>
  .channels {
    display: grid;
    gap: 16px;
  }

  h2 {
    font-size: 1.2rem;
  }

  .note {
    font-size: 0.95rem;
  }

  .big {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--white);
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    word-break: break-word;
  }

  .big:hover {
    color: var(--red);
  }

  .btn-whatsapp {
    background: #25d366;
    color: #06240f;
  }
</style>
