---
/**
 * Layout shared by the solution pages (automation, custom software, AI and
 * ERP). All the text comes from `solutions.<kind>` in each language file.
 */
import type { ComponentProps } from 'astro/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import RedLight from './RedLight.astro';
import Icon from './Icon.astro';
import SolutionVisual from './SolutionVisual.astro';
import { localizePath, t, type Lang } from '../i18n';
import { site, whatsappLink } from '../config/site';

type IconName = ComponentProps<typeof Icon>['name'];

interface Props {
  lang: Lang;
  kind: 'ai' | 'erp' | 'automation' | 'software';
}
const { lang, kind } = Astro.props;
const { solutions, contact } = t(lang);
const page = solutions[kind];
const path = `/${kind}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: page.eyebrow,
    serviceType: page.eyebrow,
    description: page.description,
    url: `${site.url}${localizePath(lang, path)}`,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: site.areaServed,
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: solutions.capabilitiesHeading,
      itemListElement: page.capabilities.map((c) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: c.title, description: c.text },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout lang={lang} title={page.title} description={page.description} path={path} schema={schema}>
  <section class="hero">
    <RedLight variant="subtle" />
    <div class="dot-grid" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div>
        <span class="eyebrow">{page.eyebrow}</span>
        <h1>{page.heading} <span class="gradient-text">{page.headingAccent}</span></h1>
        <p class="lead">{page.lead}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={localizePath(lang, '/start-project')}>{t(lang).nav.cta}</a>
          <a class="btn btn-ghost" href={whatsappLink(contact.whatsappMessage)} target="_blank" rel="noopener"
            >{contact.whatsappButton}</a
          >
        </div>
      </div>
      <SolutionVisual lang={lang} kind={kind} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal><h2>{solutions.capabilitiesHeading}</h2></div>
      <div class={`grid caps ${page.capabilities.length % 3 === 0 ? "caps-3" : ""}`}>
        {
          page.capabilities.map((c, i) => (
            <article class="card card-hover" data-reveal style={`--d:${i % 4}`}>
              <span class="icon">
                <Icon name={c.icon as IconName} size={24} />
              </span>
              <h3>{c.title}</h3>
              <p class="muted">{c.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <div class="section-head" data-reveal><h2>{page.useCasesHeading}</h2></div>
      <div class="grid grid-3">
        {
          page.useCases.map((u, i) => (
            <div class="use" data-reveal style={`--d:${i % 3}`}>
              <h3>{u.title}</h3>
              <p class="muted">{u.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    page.principles.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head" data-reveal>
            <h2>{page.principlesHeading}</h2>
          </div>
          <div class="grid principles">
            {page.principles.map((p, i) => (
              <div class="card" data-reveal style={`--d:${i}`}>
                <span class="tick">
                  <Icon name="shield" size={20} />
                </span>
                <h3>{p.title}</h3>
                <p class="muted">{p.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal><h2>{solutions.processHeading}</h2></div>
      <ol class="grid steps">
        {
          page.process.map((step, i) => (
            <li class="card" data-reveal style={`--d:${i}`}>
              <span class="num">{i + 1}</span>
              <h3>{step.title}</h3>
              <p class="muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 data-reveal>{solutions.faqHeading}</h2>
      <div class="faqs">
        {
          page.faqs.map((f, i) => (
            <details class="faq" data-reveal style={`--d:${i}`}>
              <summary>{f.q}</summary>
              <p class="muted">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band" data-reveal>
        <h2>{solutions.ctaHeading}</h2>
        <p>{solutions.ctaText}</p>
        <a class="btn btn-primary" href={localizePath(lang, '/start-project')}>{t(lang).nav.cta}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(56px, 9vw, 112px) clamp(32px, 5vw, 64px);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 48px;
    align-items: center;
  }

  .hero h1 {
    max-width: 18ch;
  }

  .hero .lead {
    margin-bottom: 2rem;
  }

  .caps {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  /* Six items sit better in rows of three. */
  .caps-3 {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .icon,
  .tick {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--red-soft);
    color: var(--red);
    margin-bottom: 16px;
  }

  .band {
    background: linear-gradient(180deg, transparent, rgb(255 49 48 / 0.06), transparent);
  }

  .use {
    padding: 4px 0 4px 20px;
    border-left: 3px solid var(--red);
  }

  .use h3 {
    margin-bottom: 0.3em;
  }

  .use p {
    margin: 0;
  }

  .principles {
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }

  .narrow {
    max-width: 820px;
  }

  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: 1.15fr 1fr;
    }
  }
</style>
