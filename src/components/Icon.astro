---
/** Small line icons, inlined so they need no extra downloads. */
const paths = {
  code: 'M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16',
  'web-mobile': 'M3 5h13v10H3zM7 19h5M9.5 15v4M17 9h4v11h-4z',
  cloud: 'M7 18h10a4 4 0 0 0 .5-7.97A6 6 0 0 0 6.1 9.6 4.2 4.2 0 0 0 7 18z',
  shield: 'M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z M8.5 12l2.5 2.5 4.5-5',
  wallet: 'M3 7h18v12H3zM3 7l3-3h12l3 3M16 13h2',
  signal: 'M4 20v-3M9 20v-7M14 20v-11M19 20V5',
  arrow: 'M5 12h14M13 6l6 6-6 6',
} as const;

interface Props {
  name: keyof typeof paths;
  size?: number;
}
const { name, size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"><path d={paths[name]}></path></svg>
