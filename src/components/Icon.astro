  mail: 'M3 6h18v12H3zM3 7l9 6 9-6',
} as const;

interface Props {
  name: keyof typeof paths;
  size?: number;
}
const { name, size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"><path d={paths[name]}></path></svg>
