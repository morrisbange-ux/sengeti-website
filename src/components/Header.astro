---
import { Image } from 'astro:assets';
import logo from '../assets/brand/sengeti-logo-white.png';
import { localizePath, t, type Lang } from '../i18n';
import { site } from '../config/site';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const { nav } = t(lang);

const links = [
  { href: '/', label: nav.home },
  { href: '/about', label: nav.about },
  { href: '/products', label: nav.products },
  { href: '/services', label: nav.services },
  { href: '/contact', label: nav.contact },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localizePath(lang, '/')} aria-label={`${site.name}, ${nav.home}`}>
      <Image src={logo} alt={site.name} width={132} densities={[1, 2]} loading="eager" fetchpriority="high" />
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={localizePath(lang, l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-primary btn-sm" href={localizePath(lang, '/contact')}>{nav.cta}</a>
    </nav>

    <details class="nav-mobile">
      <summary>
        <span class="sr-only">{nav.menu}</span>
        <span class="burger" aria-hidden="true"><span></span></span>
      </summary>
      <nav aria-label="Main">
        <ul>
          {
            links.map((l) => (
              <li>
                <a href={localizePath(lang, l.href)} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="btn btn-primary" href={localizePath(lang, '/contact')}>{nav.cta}</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(11 11 12 / 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
  }

  .brand {
    display: block;
    padding-block: 10px;
  }

  .brand img {
    width: 132px;
    height: auto;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a:not(.btn) {
    text-decoration: none;
    color: var(--muted);
    font-weight: 550;
    transition: color 0.2s;
  }

  nav a:not(.btn):hover,
  nav a[aria-current='page'] {
    color: var(--white);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: 32px;
  }

  .nav-desktop ul {
    display: flex;
    gap: 28px;
  }

  .btn-sm {
    min-height: 40px;
    padding: 0.5em 1.1em;
  }

  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-right: -10px;
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .burger,
  .burger span,
  .burger::before,
  .burger::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  .burger {
    position: relative;
    background: transparent;
  }

  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .burger::before {
    top: -7px;
  }

  .burger::after {
    top: 7px;
  }

  details[open] .burger span {
    opacity: 0;
  }

  details[open] .burger::before {
    transform: translateY(7px) rotate(45deg);
  }

  details[open] .burger::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-mobile nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--black);
    border-bottom: 1px solid var(--border);
    padding: 8px var(--gutter) 24px;
  }

  .nav-mobile li a {
    display: block;
    padding: 14px 0;
    font-size: 1.15rem;
    border-bottom: 1px solid var(--border);
  }

  .nav-mobile .btn {
    width: 100%;
    margin-top: 20px;
  }

  @media (min-width: 900px) {
    .nav-desktop {
      display: flex;
    }
    .nav-mobile {
      display: none;
    }
    .brand img {
      width: 150px;
    }
  }
</style>
