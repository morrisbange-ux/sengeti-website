---
/**
 * The flowing red light behind the page, drawn with SVG so it costs a few
 * hundred bytes instead of a large image.
 */
interface Props {
  variant?: 'hero' | 'subtle';
}
const { variant = 'hero' } = Astro.props;
---

<div class:list={['redlight', variant]} aria-hidden="true">
  <div class="halo"></div>
  <!-- Each flow is its own SVG so the browser can slide it as one ready-made layer, instead of
       redrawing the blurred glow on every frame (that redraw made clicks feel slow). -->
  <svg class="flow flow-a" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="rl-stroke" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#ff3130" stop-opacity="0"></stop>
        <stop offset="0.35" stop-color="#ff3130" stop-opacity="0.9"></stop>
        <stop offset="0.7" stop-color="#ff6a4d" stop-opacity="1"></stop>
        <stop offset="1" stop-color="#ff3130" stop-opacity="0"></stop>
      </linearGradient>
      <filter id="rl-glow" x="-20%" y="-50%" width="140%" height="200%">
        <feGaussianBlur stdDeviation="26"></feGaussianBlur>
      </filter>
      <filter id="rl-soft" x="-20%" y="-50%" width="140%" height="200%">
        <feGaussianBlur stdDeviation="4"></feGaussianBlur>
      </filter>
    </defs>
    <g>
      <path
        d="M-100 720 C 260 560, 420 820, 760 600 S 1180 260, 1560 360"
        stroke="url(#rl-stroke)"
        stroke-width="70"
        fill="none"
        filter="url(#rl-glow)"></path>
      <path
        d="M-100 720 C 260 560, 420 820, 760 600 S 1180 260, 1560 360"
        stroke="url(#rl-stroke)"
        stroke-width="5"
        fill="none"
        filter="url(#rl-soft)"></path>
    </g>
  </svg>
  <svg class="flow flow-b" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    <g>
      <path
        d="M-120 520 C 300 420, 520 700, 880 480 S 1260 160, 1580 220"
        stroke="url(#rl-stroke)"
        stroke-width="40"
        stroke-opacity="0.55"
        fill="none"
        filter="url(#rl-glow)"></path>
      <path
        d="M-120 520 C 300 420, 520 700, 880 480 S 1260 160, 1580 220"
        stroke="url(#rl-stroke)"
        stroke-width="2"
        stroke-opacity="0.8"
        fill="none"></path>
    </g>
  </svg>
</div>

<style>
  .redlight {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .halo {
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(ellipse 60% 50% at 85% 20%, rgb(255 49 48 / 0.22), transparent 70%),
      radial-gradient(ellipse 50% 40% at 5% 95%, rgb(255 49 48 / 0.14), transparent 70%);
    animation: breathe 16s ease-in-out infinite;
  }

  /* Keeps text readable where it sits over the light. */
  .redlight::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgb(var(--bg-rgb) / 0.75) 0%, rgb(var(--bg-rgb) / 0.35) 45%, transparent 70%);
  }

  .redlight::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 30%;
    background: linear-gradient(transparent, var(--black));
  }

  /* Larger than the hero so the drifting light never shows an edge. */
  svg {
    position: absolute;
    inset: -12%;
    width: 124%;
    height: 124%;
  }

  @media (max-width: 700px) {
    .redlight::before {
      background: linear-gradient(180deg, rgb(var(--bg-rgb) / 0.05) 0%, rgb(var(--bg-rgb) / 0.55) 50%, rgb(var(--bg-rgb) / 0.15) 100%);
    }
    svg {
      /* translate and scale combine with the drift animation's transform. */
      translate: 0 4%;
      scale: 1.9;
    }
  }

  .subtle {
    opacity: 0.45;
  }

  .flow {
    transform-origin: center;
  }

  .flow-a {
    animation: drift-a 22s ease-in-out infinite;
  }

  .flow-b {
    animation: drift-b 17s ease-in-out infinite;
  }

  /* The glow drifts slowly and never stops. Only transform and opacity change, so the
     browser moves ready-made layers and the page stays fast. */
  @keyframes drift-a {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
      opacity: 1;
    }
    33% {
      transform: translate3d(-90px, 40px, 0) rotate(-2.5deg) scale(1.06, 1.14);
      opacity: 0.75;
    }
    66% {
      transform: translate3d(60px, -30px, 0) rotate(2deg) scale(1.1, 0.94);
      opacity: 1;
    }
  }

  @keyframes drift-b {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
      opacity: 0.85;
    }
    50% {
      transform: translate3d(110px, -45px, 0) rotate(3deg) scale(1.12, 0.9);
      opacity: 1;
    }
  }

  @keyframes breathe {
    0%,
    100% {
      transform: scale(1) translate3d(0, 0, 0);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.15) translate3d(-3%, 2%, 0);
      opacity: 1;
    }
  }
</style>
