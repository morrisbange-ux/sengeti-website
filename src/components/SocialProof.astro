---
/**
 * Client logos and testimonials. Renders nothing until entries exist in
 * src/content/clients/ or src/content/testimonials/.
 */
import { Image } from 'astro:assets';
import { localizePath, t, type Lang } from '../i18n';
import { clientsPage } from '../i18n/pages/clients';
import { getClients, getTestimonials } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { home } = t(lang);
const cp = clientsPage[lang];
const [clients, testimonials] = await Promise.all([getClients(), getTestimonials()]);
---

{
  (clients.length > 0 || testimonials.length > 0) && (
    <section class="section">
      <div class="container">
        {clients.length > 0 && (
          <div class="clients" data-reveal>
            <p class="eyebrow">{home.clientsHeading}</p>
            <ul>
              {clients.map((c) => (
                <li>
                  <a href={localizePath(lang, '/clients')} title={c.data.name}>
                    <Image src={c.data.logo} alt={c.data.name} height={64} fit="contain" densities={[1, 2]} />
                  </a>
                </li>
              ))}
            </ul>
            <a class="more" href={localizePath(lang, '/clients')}>
              {cp.homeLink} →
            </a>
          </div>
        )}
        {testimonials.length > 0 && (
          <>
            <div class="section-head" data-reveal>
              <h2>{home.testimonialsHeading}</h2>
            </div>
            <div class="grid grid-3">
              {testimonials.map((q, i) => (
                <figure class="card quote" data-reveal style={`--d:${i}`}>
                  <blockquote>“{q.data.quote}”</blockquote>
                  <figcaption>
                    {q.data.photo && <Image src={q.data.photo} alt="" width={44} height={44} densities={[1, 2]} />}
                    <span>
                      <strong>{q.data.name}</strong>
                      {(q.data.role || q.data.organisation) && (
                        <span class="muted">{[q.data.role, q.data.organisation].filter(Boolean).join(', ')}</span>
                      )}
                    </span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </>
        )}
      </div>
    </section>
  )
}

<style>
  .clients {
    text-align: center;
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .clients ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 28px 48px;
  }

  /* Logos sit on white tiles so every client's colours look right in both themes. */
  .clients li a {
    display: grid;
    place-items: center;
    height: 96px;
    min-width: 132px;
    padding: 14px 22px;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 12px 30px -16px rgb(0 0 0 / 0.5);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .clients li a:hover {
    transform: translateY(-4px);
  }

  .clients img {
    height: 64px;
    width: auto;
  }

  .more {
    display: inline-block;
    margin-top: 24px;
    color: var(--red-text);
    font-weight: 600;
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }

  .quote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  blockquote {
    margin: 0;
    font-size: 1.1rem;
    color: var(--white);
  }

  figcaption {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  figcaption img {
    border-radius: 50%;
  }

  figcaption > span {
    display: grid;
  }
</style>
