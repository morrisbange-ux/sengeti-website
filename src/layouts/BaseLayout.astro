---
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import poppins700 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';
import '../styles/global.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { site, socialProfiles } from '../config/site';
import { defaultLang, langs, localizePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Site path without language prefix, e.g. "/about". Used for canonical and language links. */
  path: string;
  image?: string;
  /** Extra structured data (JSON-LD) for this page. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { lang, title, description, path, image, schema = [], noindex = false } = Astro.props;
const dict = t(lang);
const canonical = new URL(localizePath(lang, path), site.url).href;
// Each page gets its own share picture, made after the build by integrations/og-images.mjs.
const ogKey = localizePath(lang, path).replace(/^\/+|\/+$/g, '') || 'index';
const imageUrl = new URL(image ?? (noindex ? '/og-image.png' : `/og/${ogKey}.png`), site.url).href;

const organization = {
  '@context': 'https://schema.org',
  // ProfessionalService lets Google show the business locally (Maps, local search).
  '@type': ['Organization', 'ProfessionalService'],
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: new URL('/icon-512.png', site.url).href,
  description: dict.home.description,
  email: site.email,
  telephone: site.phone,
  founder: { '@type': 'Person', name: site.founder },
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: site.countryCode },
  areaServed: site.areaServed,
  knowsLanguage: langs.map((l) => t(l).langCode),
  sameAs: socialProfiles().map((s) => s.href),
  image: new URL('/og-image.png', site.url).href,
  hasMap: site.mapUrl,
};
const jsonLd = [organization, ...schema];
---

<!doctype html>
<html lang={dict.langCode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Apply a saved light/dark choice before the page paints, so it never flashes.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <link rel="preload" href={poppins700} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      langs.length > 1 &&
        langs.map((l) => (
          <link rel="alternate" hreflang={t(l).langCode} href={new URL(localizePath(l, path), site.url).href} />
        ))
    }
    {langs.length > 1 && <link rel="alternate" hreflang="x-default" href={new URL(localizePath(defaultLang, path), site.url).href} />}

    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={dict.locale} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={t(l).locale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      site.analytics.plausibleDomain && (
        <script
          is:inline
          type="text/plain"
          data-consent="analytics"
          data-domain={site.analytics.plausibleDomain}
          data-src="https://plausible.io/js/script.js"
        />
      )
    }
    {
      site.analytics.cloudflareToken && (
        <script
          is:inline
          type="text/plain"
          data-consent="analytics"
          data-src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.analytics.cloudflareToken })}
        />
      )
    }
  </head>
  <body>
    <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="cursor-light" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">{dict.nav.skip}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <ChatWidget lang={lang} />
    <CookieConsent lang={lang} />
    <script>
      // Fades sections in as they scroll into view.
      const items = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }

      const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Header gets its glowing edge once the page has scrolled.
      const header = document.querySelector('.site-header');
      const onScroll = () => header?.classList.toggle('scrolled', scrollY > 12);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Every interactive card gets a lit edge that follows the pointer.
      document.querySelectorAll('.card-hover').forEach((card) => {
        const edge = document.createElement('span');
        edge.className = 'edge';
        edge.setAttribute('aria-hidden', 'true');
        card.append(edge);
      });

      if (finePointer && !calm) {
        // A soft light trails the pointer, eased so it glides rather than jumps.
        const light = document.querySelector<HTMLElement>('.cursor-light');
        let tx = -999, ty = -999, x = -999, y = -999, raf = 0;
        const glide = () => {
          x += (tx - x) * 0.14;
          y += (ty - y) * 0.14;
          light?.style.setProperty('--cx', `${x}px`);
          light?.style.setProperty('--cy', `${y}px`);
          raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(glide) : 0;
        };
        document.addEventListener('pointermove', (e) => {
          if (x === -999) { x = e.clientX; y = e.clientY; }
          tx = e.clientX;
          ty = e.clientY;
          light?.classList.add('on');
          if (!raf) raf = requestAnimationFrame(glide);
        }, { passive: true });
        document.documentElement.addEventListener('pointerleave', () => light?.classList.remove('on'));

        // Cards: spotlight position and a gentle 3D tilt towards the pointer.
        let lastCard: HTMLElement | null = null;
        document.addEventListener('pointermove', (e) => {
          const card = (e.target as Element).closest?.<HTMLElement>('.card-hover');
          if (lastCard && lastCard !== card) {
            lastCard.classList.remove('tilting');
            lastCard.style.removeProperty('--rx');
            lastCard.style.removeProperty('--ry');
          }
          lastCard = card;
          if (!card) return;
          const r = card.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width;
          const py = (e.clientY - r.top) / r.height;
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
          // Big cards tilt less, so text never swims.
          const k = Math.min(1, 380 / Math.max(r.width, r.height)) * 5;
          card.style.setProperty('--rx', `${((0.5 - py) * k).toFixed(2)}deg`);
          card.style.setProperty('--ry', `${((px - 0.5) * k).toFixed(2)}deg`);
          card.classList.add('tilting');
        }, { passive: true });

        // Buttons lean a little towards the pointer, like a magnet.
        document.querySelectorAll<HTMLElement>('.btn').forEach((btn) => {
          btn.addEventListener('pointermove', (e) => {
            const r = btn.getBoundingClientRect();
            btn.style.setProperty('--bx', `${((e.clientX - r.left) / r.width - 0.5) * 8}px`);
            btn.style.setProperty('--by', `${((e.clientY - r.top) / r.height - 0.5) * 6}px`);
          });
          btn.addEventListener('pointerleave', () => {
            btn.style.removeProperty('--bx');
            btn.style.removeProperty('--by');
          });
        });
      } else if (finePointer) {
        document.addEventListener('pointermove', (e) => {
          const card = (e.target as Element).closest?.<HTMLElement>('.card-hover');
          if (!card) return;
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      }
    </script>
  </body>
</html>
